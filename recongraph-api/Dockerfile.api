FROM python:3.13-slim

WORKDIR /app

COPY requirements.txt .

RUN apt-get update && apt-get install -y \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir -r requirements.txt
# Re-add dependencies in case requirements.txt doesn't have everything properly
RUN pip install --no-cache-dir sqlalchemy alembic asyncpg celery redis python-jose[cryptography] passlib[bcrypt]

COPY . .

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
